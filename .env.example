# Local models. Nothing here should ever point at a remote API.
OLLAMA_HOST=http://127.0.0.1:11434
PALIMPSEST_MODEL=gemma3:4b
PALIMPSEST_EMBED=nomic-embed-text

# Optional: Sentry Agent Tracing (partner category). Leave empty to stay offline.
SENTRY_DSN=
SENTRY_ENVIRONMENT=palimpsest-local
PALIMPSEST_RELEASE=0.1.0
